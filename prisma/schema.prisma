generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CategoryType {
  INCOME
  BUSINESS_EXPENSE
  OWNER_DRAW
}

enum AccountStatus {
  PENDING
  PARTIAL
  PAID
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InventoryMovementType {
  IN
  OUT
  ADJUST
}

model Category {
  id           String        @id @default(cuid())
  name         String
  type         CategoryType
  transactions Transaction[]

  @@unique([name, type])
}

model Transaction {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime @default(now())
  description String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([categoryId])
}

model AccountReceivable {
  id          String        @id @default(cuid())
  clientName  String
  description String?
  amount      Decimal       @db.Decimal(12, 2)
  paidAmount  Decimal       @db.Decimal(12, 2) @default(0)
  dueDate     DateTime
  status      AccountStatus @default(PENDING)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([dueDate])
  @@index([status])
}

model AccountPayable {
  id           String        @id @default(cuid())
  supplierName String
  description  String?
  amount       Decimal       @db.Decimal(12, 2)
  paidAmount   Decimal       @db.Decimal(12, 2) @default(0)
  dueDate      DateTime
  status       AccountStatus @default(PENDING)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([dueDate])
  @@index([status])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(STAFF)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
  @@index([active])
}

model Client {
  id           String        @id @default(cuid())
  name         String
  phone        String?
  email        String?
  notes        String?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]

  @@index([name])
  @@index([active])
}

model Barber {
  id                String        @id @default(cuid())
  name              String
  phone             String?
  email             String?
  commissionPercent Decimal       @db.Decimal(5, 2) @default(0)
  active            Boolean       @default(true)
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  appointments      Appointment[]

  @@index([name])
  @@index([active])
}

model Service {
  id              String        @id @default(cuid())
  name            String
  description     String?
  price           Decimal       @db.Decimal(12, 2)
  durationMinutes Int           @default(30)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  appointments    Appointment[]

  @@unique([name])
  @@index([active])
}

model Appointment {
  id        String            @id @default(cuid())
  clientId  String
  client    Client            @relation(fields: [clientId], references: [id])
  barberId  String
  barber    Barber            @relation(fields: [barberId], references: [id])
  serviceId String
  service   Service           @relation(fields: [serviceId], references: [id])
  startsAt  DateTime
  endsAt    DateTime
  status    AppointmentStatus @default(SCHEDULED)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([startsAt])
  @@index([status])
  @@index([clientId])
  @@index([barberId])
  @@index([serviceId])
}

model Product {
  id          String              @id @default(cuid())
  name        String
  sku         String?             @unique
  description String?
  salePrice   Decimal             @db.Decimal(12, 2)
  costPrice   Decimal             @db.Decimal(12, 2) @default(0)
  stock       Int                 @default(0)
  minStock    Int                 @default(0)
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  movements   InventoryMovement[]

  @@index([name])
  @@index([active])
  @@index([stock])
}

model InventoryMovement {
  id        String                @id @default(cuid())
  productId String
  product   Product               @relation(fields: [productId], references: [id])
  type      InventoryMovementType
  quantity  Int
  note      String?
  createdAt DateTime              @default(now())

  @@index([productId])
  @@index([createdAt])
  @@index([type])
}

model BusinessSettings {
  id           String   @id @default("default")
  businessName String   @default("Barber Studio")
  phone        String?
  email        String?
  address      String?
  currency     String   @default("USD")
  taxRate      Decimal  @db.Decimal(5, 2) @default(0)
  openTime     String   @default("09:00")
  closeTime    String   @default("19:00")
  updatedAt    DateTime @updatedAt
}
